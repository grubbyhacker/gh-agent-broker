BROKER_ADMIN_SECRET=replace-me-admin-secret
HERMES_AGENT_BROKER_SECRET=replace-me-agent-secret
BROKER_REPORTER_01_SECRET=replace-me-reporter-secret
YKM_CURATOR_BROKER_SECRET=replace-me-curator-secret
SANDBOX_MCP_TOKEN=replace-me-sandbox-token
GH_AGENT_PROXY_TOKEN=replace-me-proxy-token
LITELLM_MASTER_KEY=replace-me-litellm-master-key
OPENAI_API_KEY=replace-me-provider-key
# Shared deployment-owned token for the broker's PRIVATE capability API. The
# sandbox broker authenticates its /v1/capabilities/* endpoints with this; the
# model proxy presents it to verify/reserve. It is NOT a run handle and must
# never be injected into a launched run's environment.
GH_AGENT_CAPABILITY_API_TOKEN=replace-me-capability-api-token
